{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check . && deno test --allow-read=../../fixtures",
    "fixtures": "deno run --allow-read=../../fixtures --allow-write=../../fixtures matt-import/varianten.ts"
  }
}
